{
  "name": "stellwerk",
  "private": true,
  "license": "MIT",
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run && cargo test --workspace",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:watch": "vitest",
    "abdeckung": "vitest run --coverage",
    "abdeckung:rust": "cargo llvm-cov --workspace --ignore-filename-regex \"(src-tauri/src/(main|start|schluesselbund)\\.rs|crates/stellwerk-testserver/.*)$\" --fail-under-functions 100 --fail-under-lines 100",
    "pruefen": "node scripts/pruefen.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
